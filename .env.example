# ==============================================================================
# EDAI x AnalogVerifier Environment Configuration (.env.example)
# Copy this file to `.env` in the repository root and fill in your keys.
# Detailed guide: docs/EXTERNAL_APIS.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Inference API (REQUIRED: choose at least one provider)
# ------------------------------------------------------------------------------
# Supported: wusrouter | nim | groq | openrouter
LLM_PROVIDER=wusrouter

WUSROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional custom OpenAI-compatible base URLs
# WUSROUTER_BASE_URL=https://wusrouter.com/v1
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Optional Harness2 dual-provider routing (defaults to LLM_PROVIDER)
# HARNESS2_IMPROVER_PROVIDER=
# HARNESS2_SYNTHESIZER_PROVIDER=

# Optional model & budget overrides
# LLM_MODEL=
# LLM_FAST_MODEL=
# LLM_CAPABLE_MODEL=
# LLM_FRONTIER_MODEL=
# LLM_FALLBACK_MODELS=
# LLM_BUDGET_USD=

# ------------------------------------------------------------------------------
# 2. PDF VLM Layout Parser (OPTIONAL, recommended for datasheet tables)
# ------------------------------------------------------------------------------
# Uses NVIDIA_API_KEY (nvidia/nemotron-parse). Falls back to PyMuPDF if unset.

# ------------------------------------------------------------------------------
# 3. Academic Literature & IEEE MCP (REQUIRED for full autonomous pipeline)
# ------------------------------------------------------------------------------
# Strictly required by WebCircuitReferenceSearcher in AutonomousAnalogDesignAgent,
# HermesAnalogTools, and Harness2CircuitArchitect.
IEEE_API_KEY=

# Optional external IEEE MCP server over stdio (falls back to IEEE_API_KEY -> OpenAlex)
# IEEE_MCP_COMMAND=python
# IEEE_MCP_ARGS=-m ai_analog_designer.mcp_server

# ------------------------------------------------------------------------------
# 4. Optional External Services & Observability
# ------------------------------------------------------------------------------
# Arize Phoenix local OpenTelemetry tracing (no API key required)
PHOENIX_ENABLED=1
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=analogverifier

# Optional Jev remote System-1 tool router (falls back to local rule router)
# JEV_ENDPOINT=
# JEV_API_KEY=

# ------------------------------------------------------------------------------
# 5. Local Simulators, PDK, Models & SVG Tools (non-API external binaries)
# ------------------------------------------------------------------------------
# LTspice (Windows default; spice_sweep_engine uses LTSPICE_EXE, ltspice_runner uses LTSPICE_PATH)
# LTSPICE_EXE=
# LTSPICE_PATH=

# ngspice & GF180 PDK (optional; gm/ID falls back to devices_gf180.json if unset)
# EDAI_NGSPICE=
# EDAI_PDK_DIR=

# Local FLAN-T5 weights directory (falls back to built-in op-amp block library)
# EDAI_MODEL_DIR=

# Node.js & netlistsvg for schematic SVG rendering (falls back to Python SVG renderer)
# EDAI_NODE=
# EDAI_NETLISTSVG=
