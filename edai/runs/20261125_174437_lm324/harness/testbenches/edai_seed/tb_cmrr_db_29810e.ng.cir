VPOS vp 0 5
VMID mid 0 2.5
VCM cmn mid AC 1
VIN inp cmn 0
LFB out inn 1G
CFB inn cmn 1G
RL out mid 10000
CL out mid 2e-11
Rpark1 park1 mid 100k
Rpark2 park2 mid 100k
Rpark3 park3 mid 100k
XDUT inn inp out park1 mid park1 park2 mid park2 park3 mid park3 nc_NC 0 vp LM324

.ac dec 20 0.1 1G
.meas ac m_a0__db find vdb(out) at=0.1
.meas ac m_a0__ph find vp(out) at=0.1
.meas ac m_ugf WHEN vm(out)=1 fall=1
.meas ac m_ph__db find vdb(out) WHEN vm(out)=1 fall=1
.meas ac m_ph__ph find vp(out) WHEN vm(out)=1 fall=1
.control
run
.endc
