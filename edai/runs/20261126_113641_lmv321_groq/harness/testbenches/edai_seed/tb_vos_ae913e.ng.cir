XMPM5 N1 1IN_P N6 VCC_P pfet_06v0 w=100u l=1u m=20
XMPM6 N5 1IN_N N6 VCC_P pfet_06v0 w=100u l=1u m=20
XMPM7 N6 N4 VCC_P VCC_P pfet_06v0 w=100u l=2u m=20
XMPM8 N4 N4 VCC_P VCC_P pfet_06v0 w=100u l=2u m=20
