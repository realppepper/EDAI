MREF_MS3_2 REF_SX_2 REF_NB_2 V_N V_N nfet_06v0_bsim0 w=5u l=1u
.ends LM358

VPOS vp 0 5
VMID mid 0 2.5
VIN inp mid AC 1
LFB out inn 1G
CFB inn mid 1G
RL out 0 10000
CL out mid 2e-11
Rpark1 park1 mid 100k
XDUT inp inn out mid park1 park1 vp 0 nc_NC1 nc_NC2 nc_NC3 LM358

.ac dec 20 0.1 1G
.meas ac m_a0 FIND V(out) AT 0.1
.meas ac m_ugf WHEN mag(V(out))=1 FALL=1
.meas ac m_ph FIND V(out) WHEN mag(V(out))=1 FALL=1
.end
