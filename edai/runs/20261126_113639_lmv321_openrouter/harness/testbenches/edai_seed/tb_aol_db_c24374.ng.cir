.model D_ESD D (IS=1e-15 RS=10 CJO=1p BV=50)

.subckt LMV321 1IN_P GND 1IN_N OUT VCC_P
XMPM1 OUT VB2 VCC_P VCC_P pfet_06v0 w=98.2u l=2u m=14
XMPM3 N3 VB2 VCC_P VCC_P pfet_06v0 w=68.7u l=2u
XMPM4 N4 1IN_P N3 VCC_P pfet_06v0 w=43.4u l=1u
XMPM5 N5 1IN_N N3 VCC_P pfet_06v0 w=43.4u l=1u
XMNM2 OUT N4 GND GND nfet_06v0 w=82.1u l=1u m=3
XMNM4 N4_NM4 N5 GND GND nfet_06v0 w=6.03u l=1u
XMNM5 N5_NM5 N5 GND GND nfet_06v0 w=6.03u l=1u
C1 OUT N4 1p
XMNMC1 N4 VBCN N4_NM4 GND nfet_06v0 w=9.32u l=1u
XMNMC2 N5 VBCN N5_NM5 GND nfet_06v0 w=9.32u l=1u
XMPMB1 VB2 VB2 VCC_P VCC_P pfet_06v0 w=68.7u l=2u
XMNMF1 VB2 REF_NB GND GND nfet_06v0 w=24u l=2u
XMNMB2 VBCN VBCN VBCN_S1 GND nfet_06v0 w=14.9u l=2u
RBCVBCN VBCN_S1 GND 28174.6
XMPMF2 VBCN REF_PB VCC_P VCC_P pfet_06v0 w=58.6u l=2u m=2
XMREF_MN1 REF_NB REF_NB GND GND nfet_06v0 w=12u l=2u
XMREF_MN2 REF_PB REF_NB REF_NS GND nfet_06v0 w=48u l=2u
RREF_S REF_NS GND 8353.6
XMREF_MP3 REF_PB REF_PB VCC_P VCC_P pfet_06v0 w=58.6u l=2u
XMREF_MP4 REF_NB REF_PB VCC_P VCC_P pfet_06v0 w=58.6u l=2u
XMREF_MS1 REF_SX GND VCC_P VCC_P pfet_06v0 w=0.5u l=20u
XMREF_MS2 REF_PB REF_SX GND GND nfet_06v0 w=2u l=1u
XMREF_MS3 REF_SX REF_NB GND GND nfet_06v0 w=5u l=1u
.ends LMV321

VPOS vp 0 5
VMID mid 0 2.5
VIN inp mid AC 1
LFB out inn 1G
CFB inn mid 1G
RL out mid 2000
CL out mid 2e-11
XDUT inp 0 inn out vp LMV321

.ac dec 20 0.1 1G
.meas ac m_a0__db find vdb(out) at=0.1
.meas ac m_a0__ph find vp(out) at=0.1
.meas ac m_ugf WHEN vm(out)=1 fall=1
.meas ac m_ph__db find vdb(out) WHEN vm(out)=1 fall=1
.meas ac m_ph__ph find vp(out) WHEN vm(out)=1 fall=1
.control
run
.endc
.end
